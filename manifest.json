{
  "manifest_version": 3,
  "name": "Goodreads Classic Reading Challenge",
  "description": "Restores a compact, cover-only tiled view to Goodreads annual reading challenge pages.",
  "version": "1.0.9",
  "content_scripts": [
    {
      "matches": [
        "https://www.goodreads.com/readingchallenges/annual*",
        "https://www.goodreads.com/readingchallenges/gr/annual/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
